          // 1. Dapatkan string Bulan Ini dengan presisi (Format YYYY-MM)
          const now = new Date();
          const currentMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;

          // 2. Tembak database secara paralel
