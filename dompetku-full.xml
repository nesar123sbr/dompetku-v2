import type {
  PengingatPengulangan,
  StatusDanaDarurat,
} from "@/database";

const rupiahFormatter = new Intl.NumberFormat("id-ID", {
  style: "currency",
  currency: "IDR",
  maximumFractionDigits: 0,
});

const persenFormatter = new Intl.NumberFormat("id-ID", {
  style: "percent",
  maximumFractionDigits: 0,
});

const tanggalPendekFormatter = new Intl.DateTimeFormat("id-ID", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});

const tanggalWaktuFormatter = new Intl.DateTimeFormat("id-ID", {
  day: "2-digit",
  month: "short",
  year: "numeric",
  hour: "2-digit",
  minute: "2-digit",
});

export function formatRupiah(value: number) {
  const nominal = Number.isFinite(value) ? value : 0;
  return rupiahFormatter.format(nominal);
}

export function formatLabelModePenggunaan(mode: string) {
  switch (mode) {
    case "guest":
      return "Mode tamu";
    case "authenticated":
      return "Masuk dengan akun";
    default:
      return "Belum dipilih";
  }
}

export function formatTanggalIndonesiaPendek(value: string) {
  if (!value) return "-";

  const parsed = new Date(`${value}T00:00:00`);

  if (Number.isNaN(parsed.getTime())) {
    return value;
  }

  return tanggalPendekFormatter.format(parsed);
}

export function formatTanggalWaktuIndonesia(value?: string | null) {
  if (!value) return "-";

  const parsed = new Date(value);

  if (Number.isNaN(parsed.getTime())) {
    return value;
  }

  return tanggalWaktuFormatter.format(parsed);
}

export function formatLabelStatusDanaDarurat(status: StatusDanaDarurat) {
  switch (status) {
    case "belum_ada_data":
      return "Belum ada data";
    case "belum_aman":
      return "Belum aman";
    case "cukup":
      return "Cukup";
    case "aman":
      return "Aman";
    default:
      return status;
  }
}

export function formatPersen(value: number) {
  const normalized = Number.isFinite(value) ? value : 0;
  return persenFormatter.format(normalized);
}

export function formatLabelPengulangan(value: PengingatPengulangan) {
  switch (value) {
    case "sekali":
      return "Sekali";
    case "mingguan":
      return "Mingguan";
    case "bulanan":
      return "Bulanan";
    default:
      return value;
  }
}

export function formatJamMenit(value: string) {
  if (!value) return "--:--";
  return value.slice(0, 5);
}
